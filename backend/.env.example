# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stemtutor
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# ---- AI (M2): open-source models through any OpenAI-compatible API ----
USE_FAKE_AI=true
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Each model setting may be a comma-separated list, tried in order when one is busy.
# LLM_OUTLINE_MODEL=
# LLM_TERMS_MODEL=
# LLM_QUESTIONS_MODEL=
# LLM_DOUBT_MODEL=
FAKE_EMBEDDINGS=false

# ---- Student learning (M3) ----
DOUBTS_PER_DAY=20
# Listen: Sarvam text-to-speech (fake voice while SARVAM_API_KEY is blank).
TTS_MODEL=bulbul:v4-flash
TTS_VOICE_HI=ritu_hi_edtech
TTS_VOICE_KN=chaitra_kn_narration
TTS_VOICE_EN=ritu_en_edtech
# true = make a lesson's audio when it's published; false = on the first Listen tap.
TTS_PREGENERATE=false
